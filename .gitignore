# ---- Project Color Raven rules (large firmware / binaries: never commit) ----
*.zip
*.bin
*.img
*.apk
*.jar
*.so
*.xz
*.bz2
*.lz4
*_manifest.pb
payload.bin

# Build outputs & logs
build/intermediates/
build/output/
build/logs/
out/
*.log

# Extracted partition trees (analysis stays local)
donor/extracted/
donor/partitions/
base/extracted/
base/partitions/

# ---- Android Studio / Gradle (from GitHub template) ----
.gradle/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
output-metadata.json

# IntelliJ
*.iml
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Google Profiling
*.hprof

# ---- Editor / OS noise ----
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never
*.pem
.env

# Build workspace (images, zips, temp trees) — never commit
build/
# ...but DO commit these repo-tracked build assets and reports:
!tools/build/
!reports/build/
