# Never commit firmware / large binaries
*.zip
*.bin
*.img
*.apk
*.jar
*.so
*.xz
*.bz2
*.lz4
*_manifest.pb
payload.bin

# Build outputs & logs
build/intermediates/
build/output/
build/logs/
out/
*.log

# Extracted partition trees (analysis stays local)
donor/extracted/
donor/partitions/
base/extracted/
base/partitions/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never
*.keystore
*.jks
*.pem
.env
